@baseAddress = http://localhost:5195
@exampleUserId = 3fa85f64-5717-4562-b3fc-2c963f66afa6
@exampleCourseId = 08de0e39-28f4-6c4b-0015-5d362e040002


### Get Basket
GET {{baseAddress}}/api/v1/baskets/user
Accept: application/json

### Add Basket Item
Post {{baseAddress}}/api/v1/baskets/item
Accept: application/json
Content-Type: application/json
{
  "courseId": "{{exampleCourseId}}",
  "courseName": "C# Fundamentals",
  "coursePrice": 80,
  "imageUrl": "https://example.com/images/csharp.jpg",
  "userId": "{{exampleUserId}}",
  "educatorFullName": "John Doe"
}

### Delete Basket Item
DELETE {{baseAddress}}/api/v1/baskets/item/{{exampleCourseId}}
Accept: application/json

### Apply Discount Coupon
PUT {{baseAddress}}/api/v1/baskets/apply-discount-coupon
Accept: application/json
Content-Type: application/json
{
  "couponCode": "1234DNK3O7",
  "discountRate": 0.2
}

### Clear Discount Coupon
DELETE {{baseAddress}}/api/v1/baskets/clear-discount-coupon
Accept: application/json

###




